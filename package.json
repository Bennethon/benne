{
  "name": "benne",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "generate:game-ids": "node scripts/generate-game-ids.mjs",
    "predev": "npm run generate:game-ids",
    "dev": "vite",
    "prebuild": "npm run generate:game-ids",
    "build": "tsc && vite build",
    "build:itch": "npm run build && node scripts/package-itch.mjs",
    "desktop": "npm run build && electron .",
    "build:windows": "npm run build && node scripts/prepare-desktop.mjs && electron-builder --config electron-builder.config.cjs --win --x64",
    "test:desktop": "node --experimental-strip-types --test electron/protocol-path.test.cjs electron/environment.test.mjs",
    "test:desktop:smoke": "node scripts/run-electron-test.cjs scripts/smoke-desktop.cjs",
    "test:webgl": "node scripts/run-electron-test.cjs scripts/test-webgl-recovery.cjs && node scripts/run-electron-test.cjs scripts/test-webgl-recovery.cjs --startup-failure",
    "prebuild:room-preview": "npm run generate:game-ids",
    "build:room-preview": "tsc && vite build --config vite.room-preview.config.ts",
    "prebuild:character-preview": "npm run generate:game-ids",
    "build:character-preview": "tsc && vite build --config vite.character-preview.config.ts",
    "prebuild:gui-preview": "npm run generate:game-ids",
    "build:gui-preview": "tsc && vite build --config vite.gui-preview.config.ts",
    "prebuild:inventory-preview": "npm run generate:game-ids",
    "build:inventory-preview": "tsc && vite build --config vite.inventory-preview.config.ts",
    "prebuild:benne-play": "npm run generate:game-ids",
    "build:benne-play": "tsc && vite build --config vite.benne-play.config.ts",
    "watch:benne-play": "vite build --watch --config vite.benne-play.config.ts",
    "test:pathfinding": "node scripts/pathfinding-regression.mjs",
    "preview": "vite preview",
    "sync-boot-down": "node scripts/switch-game-template.mjs sync-boot-down",
    "sync-template-down": "node scripts/switch-game-template.mjs sync-template-down",
    "set-template": "node scripts/switch-game-template.mjs set-template",
    "set-template:2-click": "node scripts/switch-game-template.mjs set-template 2-click",
    "set-template:9-verb": "node scripts/switch-game-template.mjs set-template 9-verb",
    "bundle:scaffold": "node scripts/bundle-extension-scaffold.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "package:extension:minor": "node scripts/package-extension.mjs minor",
    "package:extension:major": "node scripts/package-extension.mjs major",
    "package:extension:no-bump": "node scripts/package-extension.mjs --no-bump",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p benne-editor --noEmit",
    "lint": "eslint src tests scripts electron *.config.ts --max-warnings 0 && npm --prefix benne-editor run lint",
    "validate:content": "node scripts/validate-content.mjs",
    "check:generated": "node scripts/generate-game-ids.mjs --check",
    "check": "npm run typecheck && npm run lint && npm run validate:content && npm run check:generated",
    "test:extension": "npm --prefix benne-editor test",
    "test:e2e": "playwright test",
    "test:playthrough": "playwright test -c playwright.playthrough.config.ts",
    "test:artifacts": "node scripts/test-artifacts.mjs",
    "test:ci": "npm run check && npm run test:unit && npm run test:desktop && npm run test:pathfinding",
    "test:nightly": "npm run test:ci && npm run test:extension && npm run test:e2e && npm run test:artifacts",
    "test:release": "npm run test:ci && npm run test:coverage && npm run test:extension && npm run test:e2e && npm run test:artifacts -- --vsix"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "phaser": "4.0.0-rc.7"
  }
}
