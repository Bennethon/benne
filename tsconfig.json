{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "paths": {
      "@engine/*": ["./src/engine/*"],
      "@benne/script": ["./src/engine/bennescript/index.ts"],
      "@game": ["./src/game/game.ids.ts"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "resolveJsonModule": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    /* BenneScript speech lines (`Hank: "Hi"`) are labels (docs/bennescript-ergonomics-refactor.md §9) */
    "allowUnusedLabels": true
  },
  "include": ["src"]
}
