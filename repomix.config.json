{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "benne-snapshot.md",
    "style": "xml"
  },
  "include": ["src/**/*.ts", "src/**/*.json", "docs/architecture.md", "package.json", "vite.config.ts"],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": ["node_modules", "dist", "benne-editor/build", "*.log"]
  }
}
