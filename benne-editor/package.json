    "configuration": {
      "title": "BENNE Editor",
      "properties": {
        "benneEditor.roomPreview.autoRebuildOnGameConfigChange": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When `src/game/game-config.json` changes, run `npm run build:room-preview` (debounced) so bundled settings such as `startingPlayerCharacter` stay aligned with the room preview."
        },
        "benneEditor.roomPreview.autoRebuildDebounceMs": {
          "type": "number",
          "default": 1500,
          "minimum": 300,
          "maximum": 60000,
          "description": "Wait time after the last game-config.json change before starting an automatic room preview rebuild."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "benne-editor.filterMainTree",
          "when": "view == benne-editor.main",
