  "main": "./dist/extension.js",
  "contributes": {
    "typescriptServerPlugins": [
      {
        "name": "benne-room-id-completions",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "benne-editor",
          "title": "BENNE",
          "icon": "media/benne.svg"
        }
      ]
    },
    "views": {
      "benne-editor": [
        {
          "id": "benne-editor.main",
          "name": "BENNE",
          "contextualTitle": "BENNE"
        },
        {
          "id": "benne-editor.actions",
          "name": "Actions",
          "contextualTitle": "BENNE \u2014 Actions"
        },
        {
          "id": "benne-editor.inspector",
          "type": "webview",
          "name": "Inspector",
          "contextualTitle": "BENNE \u2014 Inspector"
        }
      ]
    },
    "commands": [
      {
        "command": "benne-editor.openEditor",
