{
  "name": "benne-editor",
  "displayName": "BENNE Editor",
  "description": "Visual editor for the BENNE point-and-click adventure game engine.",
  "publisher": "bennethon",
  "version": "0.0.11",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:benne-editor.main",
    "onView:benne-editor.actions",
    "onView:benne-editor.inspector",
    "onCommand:benne-editor.openEditor",
    "onCommand:benne-editor.showSidebar",
    "onCommand:benne-editor.createGame",
    "onCommand:benne-editor.updateEngine",
    "onCommand:benne-editor.createRoom",
    "onCommand:benne-editor.addRoomProp",
    "onCommand:benne-editor.importPropsFromAsepriteTags",
    "onCommand:benne-editor.addRoomHotspot",
    "onCommand:benne-editor.addRoomPoint",
    "onCommand:benne-editor.addRoomRegion",
    "onCommand:benne-editor.addRoomWalkableArea",
    "onCommand:benne-editor.addRoomWalkableHole",
    "onCommand:benne-editor.addRoomSpawnedCharacter",
    "onCommand:benne-editor.addRoomPlayFromMethod",
    "onCommand:benne-editor.createCharacter",
    "onCommand:benne-editor.createGui",
    "onCommand:benne-editor.createInventoryItem",
    "onCommand:benne-editor.createDialog",
    "onCommand:benne-editor.importInventoryItemsFromAsepriteTags",
    "onCommand:benne-editor.importAnimationsFromAsepriteTags",
    "onCommand:benne-editor.playFromRoom",
    "onCommand:benne-editor.rebuildRoomPreview",
    "onCommand:benne-editor.rebuildCharacterPreview",
    "onCommand:benne-editor.rebuildGuiPreview",
    "onCommand:benne-editor.rebuildInventoryPreview",
    "onCommand:benne-editor.rebuildBennePlay",
    "onCommand:benne-editor.rebuildDialogPreview",
    "onCommand:benne-editor.rebuildEditorPreviewBundles",
    "onCommand:benne-editor.addPropVerbEvent",
    "onCommand:benne-editor.makePropClickable",
    "onCommand:benne-editor.addHotspotVerbEvent",
    "onCommand:benne-editor.makeCharacterClickable",
    "onCommand:benne-editor.addCharacterVerbEvent",
    "onCommand:benne-editor.addRoomCharacterVerbEvent",
    "onCommand:benne-editor.revealRoomRegionHandler",
    "onCommand:benne-editor.addRoomRegionHandler",
    "onCommand:benne-editor.addRoomInventoryUsedOnStub",
    "onCommand:benne-editor.revealRoomInventoryUsedOn",
    "onCommand:benne-editor.revealCharacterInventoryUsedOn",
    "onCommand:benne-editor.revealInventoryItemInventoryUsedOn",
    "onCommand:benne-editor.addCharacterInventoryUsedOnStub",
    "onCommand:benne-editor.filterMainTree",
    "onCommand:benne-editor.clearMainTreeFilter",
    "onCommand:benne-editor.processGameVoiceIds",
    "onCommand:benne-editor.deleteGameEntity",
    "onCommand:benne-editor.createPdc",
    "onCommand:benne-editor.openAssetsFolder"
