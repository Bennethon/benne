{
  "name": "benne-editor",
  "displayName": "BENNE Editor",
  "description": "Visual editor for the BENNE point-and-click adventure game engine.",
  "publisher": "bennethon",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:benne-editor.main",
    "onView:benne-editor.actions",
    "onView:benne-editor.inspector",
    "onCommand:benne-editor.openEditor",
    "onCommand:benne-editor.showSidebar",
    "onCommand:benne-editor.createRoom",
    "onCommand:benne-editor.addRoomProp",
    "onCommand:benne-editor.importPropsFromAsepriteTags",
    "onCommand:benne-editor.addRoomHotspot",
    "onCommand:benne-editor.addRoomPoint",
    "onCommand:benne-editor.addRoomRegion",
    "onCommand:benne-editor.addRoomSpawnedCharacter",
    "onCommand:benne-editor.createCharacter",
    "onCommand:benne-editor.createGui",
    "onCommand:benne-editor.importAnimationsFromAsepriteTags",
    "onCommand:benne-editor.rebuildRoomPreview",
    "onCommand:benne-editor.rebuildCharacterPreview",
    "onCommand:benne-editor.rebuildGuiPreview",
    "onCommand:benne-editor.rebuildEditorPreviewBundles",
    "onCommand:benne-editor.addPropVerbEvent",
    "onCommand:benne-editor.makePropClickable",
    "onCommand:benne-editor.addHotspotVerbEvent",
    "onCommand:benne-editor.makeCharacterClickable",
    "onCommand:benne-editor.addCharacterVerbEvent",
    "onCommand:benne-editor.addRoomCharacterVerbEvent",
    "onCommand:benne-editor.filterMainTree",
    "onCommand:benne-editor.clearMainTreeFilter"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "benne-editor",
          "title": "BENNE",
          "icon": "media/benne.svg"
        }
      ]
    },
    "views": {
      "benne-editor": [
        {
          "id": "benne-editor.main",
          "name": "BENNE",
          "contextualTitle": "BENNE"
        },
        {
          "id": "benne-editor.actions",
          "name": "Actions",
          "contextualTitle": "BENNE — Actions"
        },
        {
          "id": "benne-editor.inspector",
          "type": "webview",
          "name": "Inspector",
          "contextualTitle": "BENNE — Inspector"
        }
      ]
    },
    "commands": [
      {
        "command": "benne-editor.openEditor",
        "title": "Open Editor",
        "category": "BENNE"
      },
      {
        "command": "benne-editor.showSidebar",
        "title": "Show BENNE Sidebar",
        "category": "BENNE"
      },
      {
        "command": "benne-editor.openUriPreview",
        "title": "Open URI (preview)",
        "category": "BENNE"
      },
      {
        "command": "benne-editor.openRoomScriptPreview",
        "title": "Open room script",
        "category": "BENNE"
      },
      {
        "command": "benne-editor.revealRegisterRoomScript",
        "title": "Go to registerRoomScript",
        "category": "BENNE"
      },
      {
        "command": "benne-editor.revealRoomScriptEvent",
        "title": "Reveal room script event",
        "category": "BENNE"
      },
      {
        "command": "benne-editor.addPropVerbEvent",
        "title": "Add prop verb handler (room JSON + script)",
        "category": "BENNE",
        "icon": "$(add)"
      },
      {
        "command": "benne-editor.makePropClickable",
        "title": "Make room prop clickable",
        "category": "BENNE"
      },
      {
        "command": "benne-editor.addHotspotVerbEvent",
        "title": "Add hotspot verb handler (room JSON + script)",
        "category": "BENNE",
        "icon": "$(add)"
      },
      {
        "command": "benne-editor.makeCharacterClickable",
        "title": "Make character clickable",
        "category": "BENNE"
      },
      {
        "command": "benne-editor.addCharacterVerbEvent",
        "title": "Add character verb handler (character JSON + script)",
        "category": "BENNE",
        "icon": "$(add)"
      },
      {
        "command": "benne-editor.addRoomCharacterVerbEvent",
        "title": "Add room-scoped character verb handler (character JSON + room script)",
        "category": "BENNE",
        "icon": "$(add)"
      },
      {
        "command": "benne-editor.revealCharacterScriptEvent",
        "title": "Reveal character script event",
        "category": "BENNE"
      },
      {
        "command": "benne-editor.createRoom",
        "title": "Create New Room",
        "category": "BENNE",
        "icon": "$(new-folder)"
      },
      {
        "command": "benne-editor.addRoomProp",
        "title": "Add Prop",
        "category": "BENNE",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "benne-editor.importPropsFromAsepriteTags",
        "title": "Import Props from Aseprite Tags",
        "category": "BENNE",
        "icon": "$(tag)"
      },
      {
        "command": "benne-editor.addRoomHotspot",
        "title": "Add Hotspot",
        "category": "BENNE",
        "icon": "$(map)"
      },
      {
        "command": "benne-editor.addRoomPoint",
        "title": "Add Point",
        "category": "BENNE",
        "icon": "$(pinned)"
      },
      {
        "command": "benne-editor.addRoomRegion",
        "title": "Add Region",
        "category": "BENNE",
        "icon": "$(layout-panel)"
      },
      {
        "command": "benne-editor.addRoomSpawnedCharacter",
        "title": "Add Spawned Character",
        "category": "BENNE",
        "icon": "$(person-add)"
      },
      {
        "command": "benne-editor.createCharacter",
        "title": "Create Character",
        "category": "BENNE",
        "icon": "$(person-add)"
      },
      {
        "command": "benne-editor.createGui",
        "title": "Create GUI",
        "category": "BENNE",
        "icon": "$(window)"
      },
      {
        "command": "benne-editor.importAnimationsFromAsepriteTags",
        "title": "Import Animations from Aseprite Tags",
        "category": "BENNE",
        "icon": "$(cloud-download)"
      },
      {
        "command": "benne-editor.rebuildRoomPreview",
        "title": "Rebuild Room Preview Bundle",
        "category": "BENNE",
        "icon": "$(sync)"
      },
      {
        "command": "benne-editor.rebuildCharacterPreview",
        "title": "Rebuild Character Preview Bundle",
        "category": "BENNE",
        "icon": "$(sync)"
      },
      {
        "command": "benne-editor.rebuildGuiPreview",
        "title": "Rebuild GUI Preview Bundle",
        "category": "BENNE",
        "icon": "$(sync)"
      },
      {
        "command": "benne-editor.rebuildEditorPreviewBundles",
        "title": "Rebuild Editor Preview Bundles",
        "category": "BENNE",
        "icon": "$(sync)"
      },
      {
        "command": "benne-editor.filterMainTree",
        "title": "Filter BENNE tree",
        "category": "BENNE",
        "icon": "$(filter)"
      },
      {
        "command": "benne-editor.clearMainTreeFilter",
        "title": "Clear BENNE tree filter",
        "category": "BENNE",
        "icon": "$(clear-all)"
      }
    ],
    "configuration": {
      "title": "BENNE Editor",
      "properties": {
        "benneEditor.roomPreview.autoRebuildOnGameConfigChange": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When `src/game/game-config.json` changes, run `npm run build:room-preview` (debounced) so bundled settings such as `startingPlayerCharacter` stay aligned with the room preview."
        },
        "benneEditor.roomPreview.autoRebuildDebounceMs": {
          "type": "number",
          "default": 1500,
          "minimum": 300,
          "maximum": 60000,
          "description": "Wait time after the last game-config.json change before starting an automatic room preview rebuild."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "benne-editor.filterMainTree",
          "when": "view == benne-editor.main",
          "group": "navigation@0"
        },
        {
          "command": "benne-editor.clearMainTreeFilter",
          "when": "view == benne-editor.main && benneEditor.mainTreeFilterActive",
          "group": "navigation@1"
        },
        {
          "command": "benne-editor.createRoom",
          "when": "view == benne-editor.main",
          "group": "navigation@2"
        },
        {
          "command": "benne-editor.rebuildRoomPreview",
          "when": "view == benne-editor.actions",
          "group": "navigation@1"
        },
        {
          "command": "benne-editor.createCharacter",
          "when": "view == benne-editor.main",
          "group": "navigation@4"
        },
        {
          "command": "benne-editor.createGui",
          "when": "view == benne-editor.main",
          "group": "navigation@5"
        },
        {
          "command": "benne-editor.rebuildCharacterPreview",
          "when": "view == benne-editor.actions",
          "group": "navigation@3"
        },
        {
          "command": "benne-editor.rebuildGuiPreview",
          "when": "view == benne-editor.actions",
          "group": "navigation@4"
        },
        {
          "command": "benne-editor.rebuildEditorPreviewBundles",
          "when": "view == benne-editor.main",
          "group": "navigation@8"
        }
      ],
      "view/item/context": [
        {
          "command": "benne-editor.createRoom",
          "when": "view == benne-editor.main && viewItem == benneRoomsGroup",
          "group": "benne@1"
        },
        {
          "command": "benne-editor.createRoom",
          "when": "view == benne-editor.main && viewItem == benneWorkspace",
          "group": "benne@1"
        },
        {
          "command": "benne-editor.createCharacter",
          "when": "view == benne-editor.main && viewItem == benneCharsGroup",
          "group": "benne@1"
        },
        {
          "command": "benne-editor.createCharacter",
          "when": "view == benne-editor.main && viewItem == benneWorkspace",
          "group": "benne@1"
        },
        {
          "command": "benne-editor.createGui",
          "when": "view == benne-editor.main && viewItem == benneGuisGroup",
          "group": "benne@1"
        },
        {
          "command": "benne-editor.createGui",
          "when": "view == benne-editor.main && viewItem == benneWorkspace",
          "group": "benne@1"
        },
        {
          "command": "benne-editor.addRoomHotspot",
          "when": "view == benne-editor.main && viewItem == benneRoom",
          "group": "benne@2"
        },
        {
          "command": "benne-editor.addRoomPoint",
          "when": "view == benne-editor.main && viewItem == benneRoom",
          "group": "benne@2"
        },
        {
          "command": "benne-editor.addRoomRegion",
          "when": "view == benne-editor.main && viewItem == benneRoom",
          "group": "benne@2"
        },
        {
          "command": "benne-editor.addRoomProp",
          "when": "view == benne-editor.main && viewItem == benneRoom",
          "group": "benne@2"
        },
        {
          "command": "benne-editor.addRoomSpawnedCharacter",
          "when": "view == benne-editor.main && viewItem == benneRoom",
          "group": "benne@2"
        },
        {
          "command": "benne-editor.addRoomSpawnedCharacter",
          "when": "view == benne-editor.main && viewItem == benneRoomCharacter",
          "group": "benne@2"
        },
        {
          "command": "benne-editor.addRoomHotspot",
          "when": "view == benne-editor.main && viewItem == benneRoomHotspot",
          "group": "benne@2"
        },
        {
          "command": "benne-editor.addRoomPoint",
          "when": "view == benne-editor.main && viewItem == benneRoomPoint",
          "group": "benne@2"
        },
        {
          "command": "benne-editor.addRoomRegion",
          "when": "view == benne-editor.main && viewItem == benneRoomRegion",
          "group": "benne@2"
        },
        {
          "command": "benne-editor.addRoomProp",
          "when": "view == benne-editor.main && viewItem == benneRoomProp",
          "group": "benne@2"
        },
        {
          "command": "benne-editor.importPropsFromAsepriteTags",
          "when": "view == benne-editor.main && viewItem == benneRoom",
          "group": "benne@3"
        },
        {
          "command": "benne-editor.addRoomHotspot",
          "when": "view == benne-editor.main && viewItem == benneRoomSubGroupHotspots",
          "group": "benne@2"
        },
        {
          "command": "benne-editor.addRoomProp",
          "when": "view == benne-editor.main && viewItem == benneRoomSubGroupProps",
          "group": "benne@2"
        },
        {
          "command": "benne-editor.importPropsFromAsepriteTags",
          "when": "view == benne-editor.main && viewItem == benneRoomSubGroupProps",
          "group": "benne@3"
        },
        {
          "command": "benne-editor.addRoomPoint",
          "when": "view == benne-editor.main && viewItem == benneRoomSubGroupPoints",
          "group": "benne@2"
        },
        {
          "command": "benne-editor.addRoomRegion",
          "when": "view == benne-editor.main && viewItem == benneRoomSubGroupRegions",
          "group": "benne@2"
        },
        {
          "command": "benne-editor.addRoomSpawnedCharacter",
          "when": "view == benne-editor.main && viewItem == benneRoomSubGroupCharacters",
          "group": "benne@2"
        },
        {
          "command": "benne-editor.importAnimationsFromAsepriteTags",
          "when": "view == benne-editor.main && viewItem == benneCharacter",
          "group": "benne@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build:room-preview": "npm --prefix .. run build:room-preview",
    "build:character-preview": "npm --prefix .. run build:character-preview",
    "build:gui-preview": "npm --prefix .. run build:gui-preview",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
