# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.benne/desktop-build/
releases/

# VS Code extension — compiled test output (`npm run compile-tests` / `pretest`)
benne-editor/out
# Extension scaffold payload (built by `npm run bundle:scaffold`)
benne-editor/scaffold
# Extension webviews and preview bundles, rebuilt for every VSIX (`vscode:prepublish`). The
# previews are built from whichever template is in src/game: `npm --prefix benne-editor run
# build:previews`. The inspector and PDC editor come from the extension's webpack build.
benne-editor/media/*/
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.VSCodeCounter/

# Regression test artifacts
coverage/
playwright-report/
test-results/
.vitest/
benne-editor/.vscode-test/

# BenneScript handles generated from src/game/ (npm run generate:game-ids); never part of a template
src/game/**/*.ids.ts
game-templates/**/*.ids.ts

# Release builds: attached to GitHub releases, not committed (docs/publishing.md)
*.vsix

# LLM context pack, regenerated with `npm run snapshot`
benne-snapshot.md
