{
  "id": "inventoryBar",
  "name": "Inventory Bar",
  "description": "Main inventory bar displayed on screen",
  "visible": true,
  "display": {
    "aseprite": true
  },
  "controls": [
    {
      "type": "inventoryPanel",
      "id": "mainInv",
      "x": 10,
      "y": 2,
      "zIndex": 100,
      "visible": true,
      "rows": 1,
      "cols": 6,
      "slotWidth": 38,
      "slotHeight": 30,
      "spacingX": 2,
      "spacingY": 2,
      "itemScale": 1,
      "showEmptySlots": true,
      "backgroundTag": "InvBG",
      "backgroundAnchor": "screen"
    },
    {
      "type": "image",
      "id": "background",
      "x": 0,
      "y": 0,
      "display": {
        "tag": "InvBG",
        "anchor": "screen"
      }
    },
    {
      "type": "button",
      "id": "back",
      "x": 0,
      "y": 0,
      "width": 30,
      "height": 32,
      "text": "Button",
      "font": "",
      "fontSize": 16,
      "textColor": "#ffffff",
      "textAlign": "center",
      "textOffsetX": 0,
      "textOffsetY": 0,
      "backgroundTag": "BackBtn",
      "zIndex": 200,
      "anchor": "screen"
    },
    {
      "type": "text",
      "id": "test-text",
      "x": 100,
      "y": 100,
      "text": "Sample text",
      "font": "lucasarts-scumm-solid",
      "fontSize": 8,
      "color": "#ffffff",
      "zIndex": 300,
      "wordWrapWidth": 200,
      "visible": true
    }
  ]
}
