// benne.games: the VitePress build served as Workers static assets. Deployed by Workers Builds
// on every push to master (root directory `website`); see website/README.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "benne-games",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./.vitepress/dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "benne.games", "custom_domain": true }]
}
